        "categories": {
          "categories": [
            {
              "category": "Alerts",
              "description": "Error messages, failures, critical notifications from automations or dev tools where something broke or needs immediate attention. Examples: N8N workflow failed, GitHub Actions error, Supabase connection down, Make.com automation stopped, deployment failed, google reviews, google search console warnings"
            },
            {
              "category": "Finance/Billing",
              "description": "Finance/Billing related emails including invoices, payment notifications, banking alerts, subscription charges, accounting system emails, and financial services. Examples: Stripe invoices or payment confirmations, Wise Banking notifications, Xero accounting emails, hosting bills, Apple/Canva subscription charges, DigitalOcean invoices, payment received notifications, outgoing invoices sent to clients."
            },
            {
              "category": "Platform Updates",
              "description": "Tool notifications, new feature announcements, security updates from software platforms you use. Examples: GitHub new feature, Supabase status update, Netlify deployment notification, N8N security patch. Non-urgent notifications. Examples: \"We've added dark mode,\" \"API v2 available.\""
            },
            {
              "category": "Reply",
              "description": " Emails requiring your direct response. Includes questions, requests for information, meeting confirmations, decisions needed from you, or conversations where you're actively involved. If in doubt, this is Reply."
            },
            {
              "category": "Waiting",
              "description": "Emails where you've sent a proposal, waiting for a decision, or expecting a response from the other person. Examples: \"Awaiting client approval on quote,\" \"Proposal sent - waiting for feedback,\" \"Email sent to prospect - follow up pending.\" These are emails YOU sent that need follow-up."
            },
            {
              "category": "Webinar Request",
              "description": "Requests for you to speak, teach, present, or participate in webinars, podcasts, or training events. Includes speaking opportunities, panel invitations, and educational collaboration requests."
            },
            {
              "category": "Mentorship",
              "description": "Emails from business founders, thought leaders, or educational content from Dan Martell, Russell Brunson, Chris Bailey, or similar. Includes newsletters, course announcements, and strategic insights designed for learning. Do not include marketing emails or promotional content"
            },
            {
              "category": "Community",
              "description": "Community engagement emails: LinkedIn notifications, X/Twitter replies, Skool, Discord/Slack community messages, YouTube comments. Includes non-work social engagement, community discussions, networking chatter."
            }
          ]
        },
        "options": {}
      },
