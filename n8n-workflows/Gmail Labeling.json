      "parameters": {
        "inputText": "=Subject: {{ $('Gmail Trigger').item.json.subject }}\nFrom: {{ $('Gmail Trigger').item.json.from.value[0].address }}\nHas Attachments: {{ $(\"Gmail Trigger\").item.binary ? 'Yes' : 'No' }}",
        "categories": {
          "categories": [
            {
              "category": "Invoice to Pay",
              "description": "Bills and invoices FROM vendors that need to be paid.\n\nCRITICAL RULE: If \"Has Attachments: Yes\" appears in the text, this is ALWAYS an Invoice to Pay category. The presence of attachments is the primary determining factor.\n\nMust have PDF invoice attached. Examples: Stripe invoices (with PDF), X/Twitter subscription invoice (with PDF), DigitalOcean bill (with PDF), Claude invoice (with PDF), Supabase bill (with PDF), Netlify invoice (with PDF), GitHub subscription (with PDF), instantly.ai invoice (with PDF).\n\nThese are business expenses owed to vendors WITH the invoice file attached."
            },
            {
              "category": "Not an Invoice",
              "description": "Everything else including: payment received notifications, payment taken confirmations, outgoing invoices sent to clients, receipts, banking notifications, AND invoice notifications without PDF attachments (like \"view your invoice online\" emails). If \"Has Attachments\" shows \"No\", select this category."
            }
          ]
        },
