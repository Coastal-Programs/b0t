npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# logs (from pino-roll)
/logs/
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE and editor files
.vscode/
.idea/
*.swp
