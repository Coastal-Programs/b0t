*~
*.sublime-*

# Claude Code local settings
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db
*.AppleDouble
*.LSOverride

# n8n workflow exports (may contain embedded credentials)
/n8n-workflows/

# Generated files
openapi.json
email.json
/workflow/

