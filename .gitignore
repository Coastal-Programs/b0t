/plans/
/make.com workflows/

# Dev test artifacts
test-webhook-plan.yaml
test-webhook-workflow.json
test-webhook.json

# Screenshots (keep only if needed for README)
/pictures/

# Workflow translator learnings (local agent memory)
data/workflow-translator/learnings.jsonl

